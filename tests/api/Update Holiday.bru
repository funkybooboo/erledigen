meta {
  name: Update Holiday
  type: http
  seq: 123
}

put {
  url: {{baseUrl}}/api/holidays/{{holidayId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Day Renamed",
    "date": "2027-07-25"
  }
}

assert {
  res.status: eq 200
  res.body.data.name: eq Bruno Day Renamed
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return the updated holiday", function() {
    expect(res.getBody().data.name).to.equal("Bruno Day Renamed");
    expect(res.getBody().data.date).to.equal("2027-07-25");
  });
}
