meta {
  name: Create Holiday
  type: http
  seq: 120
}

post {
  url: {{baseUrl}}/api/holidays
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Day",
    "date": "2027-07-24"
  }
}

assert {
  res.status: eq 201
  res.body.data.name: eq Bruno Day
}

tests {
  test("should return 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("should return created holiday", function() {
    const holiday = res.getBody().data;
    expect(holiday.name).to.equal("Bruno Day");
    expect(holiday.date).to.equal("2027-07-24");
    expect(holiday.id).to.be.a("string");
    expect(holiday.createdAt).to.be.a("string");
  });

  test("should save holiday ID for later tests", function() {
    bru.setVar("holidayId", res.getBody().data.id);
  });
}
