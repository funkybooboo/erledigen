meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{apiPrefix}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.data.status: eq ok
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return status ok", function() {
    expect(res.getBody().data.status).to.equal("ok");
  });

  test("should report uptime, version, database, connections, and jobs (ADR-005)", function() {
    const data = res.getBody().data;
    expect(data.uptime).to.be.a("number");
    expect(data.version).to.be.a("string");
    expect(["sqlite", "memory"]).to.include(data.database.type);
    expect(data.connections.websocket).to.be.a("number");
    expect(data.jobs.pending).to.be.a("number");
    expect(data.jobs.running).to.be.a("number");
  });

  test("should echo a request ID (ADR-004)", function() {
    expect(res.getHeader("x-request-id")).to.be.a("string");
  });

  test("should have X-Content-Type-Options header", function() {
    expect(res.getHeader("x-content-type-options")).to.equal("nosniff");
  });

  test("should have X-Frame-Options header", function() {
    expect(res.getHeader("x-frame-options")).to.equal("DENY");
  });

  test("should have Content-Security-Policy header", function() {
    expect(res.getHeader("content-security-policy")).to.be.a("string");
  });
}
