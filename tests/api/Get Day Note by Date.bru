meta {
  name: Get Day Note by Date
  type: http
  seq: 130
}

get {
  url: {{baseUrl}}/api/day-notes/2027-10-04
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return the note created by Upsert Day Note", function() {
    expect(res.getBody().data.notes).to.equal("# Bruno margin note\n- first line");
  });
}
