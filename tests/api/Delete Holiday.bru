meta {
  name: Delete Holiday
  type: http
  seq: 124
}

delete {
  url: {{baseUrl}}/api/holidays/{{holidayId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should report success", function() {
    expect(res.getBody().data.success).to.equal(true);
  });
}
