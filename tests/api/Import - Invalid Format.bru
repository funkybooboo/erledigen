meta {
  name: Import - Invalid Format
  type: http
  seq: 111
}

post {
  url: {{baseUrl}}{{apiPrefix}}/import?format=xml
  body: text
  auth: none
}
body:text {
<x/>
}

assert {
  res.status: eq 400}

tests {
  test("should reject an unknown format with 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("VALIDATION_ERROR");
  });
}
