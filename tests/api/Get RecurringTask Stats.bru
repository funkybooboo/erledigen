meta {
  name: Get RecurringTask Stats
  type: http
  seq: 112
}

get {
  url: {{baseUrl}}/api/recurring-tasks/{{recurringTaskId}}/stats
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return streak aggregates", function() {
    const stats = res.getBody().data;
    expect(stats.recurringTaskId).to.equal(bru.getVar("recurringTaskId"));
    expect(stats.currentStreak).to.be.a("number");
    expect(stats.longestStreak).to.be.a("number");
    expect(stats.totalCompletions).to.be.a("number");
  });

  test("should return the completedDates heatmap history", function() {
    const stats = res.getBody().data;
    expect(Array.isArray(stats.completedDates)).to.be.true;
    // Ascending ISO dates, each within the trailing heatmap window.
    const dates = stats.completedDates;
    for (let i = 1; i < dates.length; i++) {
      expect(dates[i] > dates[i - 1]).to.be.true;
    }
  });
}
