meta {
  name: Adopt Task as Recurring - Not Found
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/api/recurring-tasks/adopt
  body: json
  auth: none
}

body:json {
  {
    "taskId": "999999",
    "frequency": "daily"
  }
}

assert {
  res.status: eq 404
}

tests {
  test("should return 404 for an unknown task", function() {
    expect(res.getStatus()).to.equal(404);
  });
}
