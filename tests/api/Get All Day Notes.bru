meta {
  name: Get All Day Notes
  type: http
  seq: 132
}

get {
  url: {{baseUrl}}/api/day-notes
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return an array in date order", function() {
    const notes = res.getBody().data;
    expect(notes).to.be.an("array");
    const dates = notes.map((n) => n.date);
    const sorted = [...dates].sort();
    expect(dates).to.deep.equal(sorted);
  });
}
