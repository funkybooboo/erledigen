meta {
  name: Upsert Day Note
  type: http
  seq: 128
}

put {
  url: {{baseUrl}}/api/day-notes/2027-10-04
  body: json
  auth: none
}

body:json {
  {
    "notes": "# Bruno margin note\n- first line"
  }
}

assert {
  res.status: eq 200
  res.body.data.date: eq 2027-10-04
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return the day note", function() {
    const note = res.getBody().data;
    expect(note.date).to.equal("2027-10-04");
    expect(note.notes).to.equal("# Bruno margin note\n- first line");
    expect(note.id).to.be.a("string");
    expect(note.createdAt).to.be.a("string");
  });
}