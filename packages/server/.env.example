# Server Configuration
PORT=4000

# CORS Configuration
CORS_ORIGIN=*

# Environment
NODE_ENV=development

# Storage adapter: 'sqlite' (persistent, default) or 'memory' (ephemeral,
# resets on restart -- useful for tests and throwaway sessions)
STORAGE_ADAPTER=sqlite

# SQLite database file path (only used when STORAGE_ADAPTER=sqlite)
DB_PATH=./data/erledigen.db
