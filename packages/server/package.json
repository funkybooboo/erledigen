{
    "name": "@erledigen/server",
    "version": "0.10.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --target bun && cp -r src/adapters/data/migrations dist/migrations",
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "type-check": "tsc --noEmit",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage"
    },
    "dependencies": {
        "@erledigen/shared": "workspace:*",
        "@asteasolutions/zod-to-openapi": "^8.5.0",
        "js-yaml": "^4.3.2",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/bun": "^1.4.0",
        "@types/js-yaml": "^4.0.9",
        "typescript": "^6.0.3"
    }
}
