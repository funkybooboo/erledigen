{
    "name": "@erledigen/client",
    "version": "0.13.2",
    "private": true,
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "type-check": "svelte-kit sync && bunx tsc --noEmit",
        "check:svelte": "svelte-kit sync && svelte-check --fail-on-warnings",
        "test": "bun test src/",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "svelte-kit sync && storybook build"
    },
    "dependencies": {
        "@erledigen/shared": "workspace:*",
        "@sveltejs/adapter-node": "^6.0.1",
        "@sveltejs/kit": "^3.1.1",
        "svelte": "^5.57.3",
        "svelte-icons-pack": "^3.1.3"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^10.6.5",
        "@storybook/addon-docs": "^10.6.5",
        "@storybook/addon-links": "^10.6.5",
        "@storybook/sveltekit": "^10.6.5",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/bun": "^1.4.0",
        "@types/node": "^25.9.5",
        "storybook": "^10.6.5",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.2.2"
    }
}
